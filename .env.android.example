# Copy to .env.android.local. Values are public and become part of the APK.
# Use reachable HTTPS servers with CORS support for https://localhost.
# Empty values disable the corresponding online provider. Never use localhost or /api here.
VITE_NETEASE_API_BASE=
VITE_KUGOU_API_BASE=
VITE_QQ_API_BASE=
# Optional Folia Web deployment origin, for its /api/lyric-proxy endpoint.
VITE_LYRIC_PROXY_ORIGIN=
